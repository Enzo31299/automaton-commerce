# Automaton Trader — PAPER ONLY
# Copy to /etc/automaton-trader/paper.env and keep permissions restricted.

TRADER_DB_PATH=/var/lib/automaton-trader/state.db
TRADER_INITIAL_EQUITY=150
TRADER_QUANTITY=0.001
TRADER_POLL_INTERVAL_MS=60000

# Explicit simulated execution costs. These do not submit real orders.
TRADER_FEE_RATE=0.001
TRADER_SLIPPAGE_RATE=0.0005

# Capital safety limits.
TRADER_MAX_POSITION_VALUE=37.5
TRADER_MAX_RISK_PER_TRADE=0.75
TRADER_MAX_DAILY_LOSS=3
TRADER_MAX_OPEN_POSITIONS=3

# Health check: two hours without a successful tick is unhealthy.
TRADER_HEALTH_MAX_TICK_AGE_MS=7200000
